{
  "manifest_version": 3,
  "name": "Language Caption",
  "version": "0.12.0",
  "description": "Language Caption — dual captions on any site (YouTube, ABEMA, Netflix, AnimeVietSub, and the open web) with JA/EN/VI modes and local NLP.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "cookies", "sidePanel", "tabs", "nativeMessaging", "alarms", "identity", "tabCapture", "offscreen", "scripting"],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*",
    "http://127.0.0.1:3000/*",
    "http://localhost:3000/*",
    "https://www.googleapis.com/*",
    "https://accounts.google.com/o/oauth2/revoke",
    "https://generativelanguage.googleapis.com/*",
    "https://stream.googleapiscdn.com/*",
    "https://graphql.anilist.co/*",
    "https://jimaku.cc/*"
  ],
  "oauth2": {
    "client_id": "886146342458-g0tav91opprcvkivnmabh3p3c2f7qjns.apps.googleusercontent.com",
    "scopes": ["https://www.googleapis.com/auth/drive"]
  },
  "background": {
    "service_worker": "background/service_worker.js"
  },
  "action": {
    "default_title": "Language Caption — Settings & Saved Items"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      }
    },
    "toggle_overlay": {
      "suggested_key": {
        "default": "Alt+H",
        "mac": "Alt+H"
      },
      "description": "Bật/tắt thanh phụ đề overlay trên video"
    },
    "toggle_pip": {
      "suggested_key": {
        "default": "Alt+P",
        "mac": "Alt+P"
      },
      "description": "Bật/tắt chế độ Picture-in-Picture"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": ["shared/timedtext_parse.js", "injected/page_capture.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "shared/vocab_style.js",
        "shared/hardsub_defaults.js",
        "shared/dfxp_parser.js",
        "shared/timedtext_parse.js",
        "shared/romaji_kana.js",
        "shared/url_hash.js",
        "shared/gemini_translate.js",
        "shared/ass_parser.js",
        "shared/anime_resolver.js",
        "content/normalize_cues.js",
        "shared/sentence_groups.js",
        "shared/sentence_benchmark.js",
        "content/cue_timing.js",
        "content/fill_yt_secondary.js",
        "content/settings_modal.js",
        "content/content.js"
      ],
      "css": ["styles/panel.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": ["content/sp_test_bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://stream.googleapiscdn.com/*"
      ],
      "js": ["content/animevietsub_player_bridge.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["shared/timedtext_parse.js", "injected/page_capture.js"],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ]
}
