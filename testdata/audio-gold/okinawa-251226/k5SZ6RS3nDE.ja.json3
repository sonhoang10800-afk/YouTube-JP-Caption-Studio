    } ]
  }, {
    "tStartMs": 1782760,
    "dDurationMs": 4080,
    "wWinId": 1,
    "segs": [ {
      "utf8": "はい。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1784029,
    "dDurationMs": 2811,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1784039,
    "dDurationMs": 3360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、記者会見終了の時間でございますが、あの、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1786830,
    "dDurationMs": 569,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1786840,
    "dDurationMs": 3559,
    "wWinId": 1,
    "segs": [ {
      "utf8": "12",
      "acAsrConf": 0
    }, {
      "utf8": "問",
      "tOffsetMs": 280,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1787389,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1787399,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "程度お受けしたいと思います。え、その他事者以外の記者の皆様ご質問ございますでしょうか?え、急法さん",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1797389,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1797399,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "すいません。あの、開閉体のア向い点についてお伺いします。開閉体のフォースデザインがこの公表されて安む拠点の第",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1805350,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1805360,
    "dDurationMs": 5000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "4、",
      "acAsrConf": 0
    }, {
      "utf8": "え、開閉連帯が、あ、シア部ですね。",
      "tOffsetMs": 880,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1808990,
    "dDurationMs": 1370,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1809000,
    "dDurationMs": 4360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "シ部の第",
      "acAsrConf": 0
    }, {
      "utf8": "4",
      "tOffsetMs": 1039,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1810350,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1810360,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "開閉連帯がクアムの部隊へと改される予定ですが、中心となりました。え、無点にも影響が出るような、え、改中止ですが、どのように受け取ってらっしゃいますでしょうか?",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1822789,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1822799,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "はい。まず、あの、米開閉隊が沖縄を拠点とする第",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1826470,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1826480,
    "dDurationMs": 3360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "4",
      "acAsrConf": 0
