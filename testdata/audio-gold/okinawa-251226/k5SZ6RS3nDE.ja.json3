    "dDurationMs": 5720,
    "wWinId": 1,
    "segs": [ {
      "utf8": "さらに",
      "acAsrConf": 0
    }, {
      "utf8": "高め",
      "tOffsetMs": 520,
      "acAsrConf": 0
    }, {
      "utf8": "て",
      "tOffsetMs": 799,
      "acAsrConf": 0
    }, {
      "utf8": "いっ",
      "tOffsetMs": 960,
      "acAsrConf": 0
    }, {
      "utf8": "て",
      "tOffsetMs": 1119,
      "acAsrConf": 0
    }, {
      "utf8": "です",
      "tOffsetMs": 1239,
      "acAsrConf": 0
    }, {
      "utf8": "ね",
      "tOffsetMs": 1440,
      "acAsrConf": 0
    }, {
      "utf8": "、",
      "tOffsetMs": 1520,
      "acAsrConf": 0
    }, {
      "utf8": "公共",
      "tOffsetMs": 2000,
      "acAsrConf": 0
    }, {
      "utf8": "サービス",
      "tOffsetMs": 2359,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 963430,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 963440,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "の市の向上と、え、事業費の削減効果を同時に、え、これからも組み立っていけるように取り組んでいきたいと思います。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 972949,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 972959,
    "dDurationMs": 1761,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ありがとうございます。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 973629,
    "dDurationMs": 1091,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 973639,
    "dDurationMs": 4081,
    "wWinId": 1,
    "segs": [ {
      "utf8": "はい、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 974710,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 974720,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "次に県外事者事通信さん、お願いいたします。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 978269,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 978279,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、県外事者の事事通信です。はい。えっと、今あの県生の重大ニュースをあのご発表いただきました。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 984790,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 984800,
    "dDurationMs": 3279,
    "wWinId": 1,
    "segs": [ {
      "utf8": "はい。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 985069,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 985079,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あの、今年を振り返りまして、あの、漢文字で表します。あの、どういった",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 989749,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 989759,
    "dDurationMs": 5681,
    "wWinId": 1,
    "segs": [ {
      "utf8": "1",
      "acAsrConf": 0
    }, {
      "utf8": "年でしたでしょうか?",
      "tOffsetMs": 121,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 992430,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 992440,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "色々ありますけれどもね、あの、ま、私は行政の長であると共に",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 998910,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 998920,
    "dDurationMs": 3520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "1",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 999430,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 999440,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "政治家でもありますので、この、ま、政治及び政治家のあり方について非常に、ま、改めて考えさせられた",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1011710,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1011720,
    "dDurationMs": 4000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "1",
      "acAsrConf": 0
    }, {
      "utf8": "年だったと思います。",
      "tOffsetMs": 160,
      "acAsrConf": 0
    }, {
      "utf8": "ま",
      "tOffsetMs": 1119,
      "acAsrConf": 0
    }, {
