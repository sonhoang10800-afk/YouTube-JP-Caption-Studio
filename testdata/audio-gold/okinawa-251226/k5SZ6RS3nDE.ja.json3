  }, {
    "tStartMs": 1398480,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "つえっと国外街なんですけどアメリカ軍府天巻基地の移設先となってる名のであの南弱自盤のあの改良工事に着して明後日で",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1407510,
    "wWinId": 1,
    "aAppend": 1,
