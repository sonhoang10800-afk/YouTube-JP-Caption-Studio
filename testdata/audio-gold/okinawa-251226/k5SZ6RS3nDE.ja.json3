    } ]
  }, {
    "tStartMs": 1894159,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ですから、引き続き今後とも日米両政府に対しては、え、この移転計画の具体的な記述や、え、規模などを明らかにして、え、この移転計画を確実に推進していただくよう求めてまいりたいと思います。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1910870,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1910880,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "他に質問はございますか?すいません。日経新聞さんお願いいたします。あ、すいません。日経新聞の裏崎です。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1921830,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1921840,
    "dDurationMs": 2400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あの、進行算の関係で、あの、",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1923909,
    "dDurationMs": 331,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1923919,
    "dDurationMs": 3321,
    "wWinId": 1,
    "segs": [ {
      "utf8": "3000",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1924230,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1924240,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "億円を下回ったということと、あと、あの、執行率の向上についても言われることがあるわけですけれども、そちらについてはどのようにお考えかめてお願いします。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1935230,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1935240,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "はい。えっと、ちょっと待ってください。どうし、そう、総務いるから。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1947269,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1947279,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "えっと、では、えっと、まず思考率の点について説明をお願いいたします。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1955430,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1955440,
    "dDurationMs": 5440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。うん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1958070,
    "dDurationMs": 2810,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1958080,
    "dDurationMs": 6319,
    "wWinId": 1,
    "segs": [ {
      "utf8": "執行率入ってますよ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
