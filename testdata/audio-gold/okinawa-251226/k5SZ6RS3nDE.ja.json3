    } ]
  }, {
    "tStartMs": 1607679,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "はい。えっと、ま、一時もあの不天マ飛向のへのこ異設反対を掲げるあのオール大沖きなあの候補のあの応援にもうすでにあの政策発表会見など入られてると思うんですけれども、あのまと重なるんですが、ま、工事はま進展をしています。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
