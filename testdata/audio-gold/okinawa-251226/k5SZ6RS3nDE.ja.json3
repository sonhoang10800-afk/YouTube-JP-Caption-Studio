    "wWinId": 1,
    "segs": [ {
      "utf8": "NHK",
      "acAsrConf": 0
    }, {
      "utf8": "さん、お願いいたします。",
      "tOffsetMs": 440,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1369470,
    "dDurationMs": 1890,
