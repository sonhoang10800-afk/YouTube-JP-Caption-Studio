    "dDurationMs": 2480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "2",
      "acAsrConf": 0
    }, {
      "utf8": "問続けて聞かせてください。えっと、",
      "tOffsetMs": 199,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1373630,
    "dDurationMs": 210,
