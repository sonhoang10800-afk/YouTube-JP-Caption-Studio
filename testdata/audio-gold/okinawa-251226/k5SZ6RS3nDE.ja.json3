      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1373840,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "問目は、えっと、今日来年度の当初予算案が確決定されます。",
      "acAsrConf": 0
    } ]
