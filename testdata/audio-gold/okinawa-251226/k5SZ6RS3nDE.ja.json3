    } ]
  }, {
    "tStartMs": 1407669,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1407679,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "年になります。また先月末には大浦側で本格的な埋め立てに向けた作業も始まっていますが明後日で工事の着手から",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1416110,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
