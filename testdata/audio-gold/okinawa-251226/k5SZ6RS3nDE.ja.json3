    "wWinId": 1,
    "segs": [ {
      "utf8": "そういうことを言う人もいるぐらいなんですね。なので非常に素晴らしいあの整備計画なんですけど、ま、そうした不安をこれから抱く県民がいらっしゃらないとも限りませんので、この辺のその説明県民の不安をどう払拭していくかちょっともう",
      "acAsrConf": 0
    } ]
