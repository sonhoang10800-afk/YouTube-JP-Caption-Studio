    } ]
  }, {
    "tStartMs": 1602080,
    "dDurationMs": 5160,
    "wWinId": 1,
    "segs": [ {
      "utf8": "はい。え、県外事者からはあの",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1604070,
    "dDurationMs": 3170,
