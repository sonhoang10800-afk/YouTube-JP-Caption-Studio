    "wWinId": 1,
    "segs": [ {
      "utf8": "1",
      "acAsrConf": 0
    }, {
      "utf8": "問名商の関連であのお聞かせください。",
      "tOffsetMs": 160,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1607669,
