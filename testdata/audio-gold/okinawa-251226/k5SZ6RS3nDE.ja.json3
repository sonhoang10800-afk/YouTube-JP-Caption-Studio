    "dDurationMs": 3159,
    "wWinId": 1,
    "segs": [ {
      "utf8": "1",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1416269,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1416279,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "年を迎えるにあたっての受け止めとが求めている計画の断念に向けて国にどう働きかけていくかをお聞かせください。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1424750,
