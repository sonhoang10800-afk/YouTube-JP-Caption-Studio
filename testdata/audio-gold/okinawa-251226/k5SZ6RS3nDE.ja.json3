    } ]
  }, {
    "tStartMs": 1355720,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、他に質問はございますか?はい。え、続いて発表事項、あ、発表事項以外の質問に移ります。えっと、県内管事者",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1367750,
