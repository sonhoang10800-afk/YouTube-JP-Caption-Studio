      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1369480,
    "dDurationMs": 4160,
    "wWinId": 1,
    "segs": [ {
      "utf8": "はい。えっと、幹事者から",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1371350,
    "dDurationMs": 2290,
    "wWinId": 1,
